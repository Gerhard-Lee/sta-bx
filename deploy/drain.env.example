# 复制成 /etc/stabx-notify.env 并 chmod 600：只给主机 cron 用，不进版本库。
# 值一律加引号：drain.sh 会 `. "$ENV_FILE"` 直接 source 这个文件，未加引号的值一旦含空格或 <...>，
# 会被 shell 拆成"赋值 + 命令"（实测报 `.env: command not found`）或重定向，cron 每 5 分钟失败一次。
STABX_URL="https://你的访问地址"
# 与前端用的是同一个 publishable key（本身就是公开值）；不要填 service role key。
STABX_APIKEY="sb_publishable_xxxxxxxx"
# 必须与 Edge Function 密钥 CRON_SECRET 完全一致
CRON_SECRET="与 .env 里同一个随机串"
# curl 的 --max-time（秒）。必须比函数侧一轮消费的预算（NOTIFY_MAX_RUNTIME_MS；托管默认 110 秒，
# 自托管 compose 覆盖里是 240 秒）大，否则客户端先断开，函数来不及把没发出去的行退回队列，
# 它们会卡在“发送中”等租约到期。
STABX_NOTIFY_TIMEOUT="300"
