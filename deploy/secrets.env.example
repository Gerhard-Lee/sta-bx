# 本项目**新增变量**的填空模板，不是一份完整可用的 .env。
# 自托管时先保留官方/安装脚本生成的那份完整 .env（POSTGRES_PASSWORD、JWT_SECRET、ANON_KEY 等平台必填项
# 都在里面），再把本文件的条目合并进去、只加不覆盖：
#   cat deploy/secrets.env.example >> .env      # 追加（模板里只有项目自己的变量）
#   chmod 600 .env                              # 只填值；不要提交、不要贴进聊天或工单
# 直接 `cp secrets.env.example .env` 会盖掉平台必填项，容器起不来。
# 值一律加引号：deploy/check.sh 会 `. ./.env` 直接 source 这个文件，未加引号的空格、<...>、中文括号
# 都会让 sh 在解析时报语法错误（`sh -n deploy/secrets.env.example` 应当无输出）。
# 生成随机密钥：openssl rand -hex 32

# —— 邮件（QQ 邮箱授权码方案）——
SMTP_HOST="smtp.qq.com"
SMTP_PORT="465"
SMTP_USER="你的账号@qq.com"
SMTP_PASS="在这里填 QQ 邮箱的 SMTP 授权码（不是 QQ 密码，也不是邮箱登录密码）"
EMAIL_FROM="成都七中科学技术协会 <你的账号@qq.com>"
# 中继自己的 Bearer 密钥：app-api 的 EMAIL_API_KEY 与 mail-relay 的 RELAY_TOKEN 共用这一个值
EMAIL_RELAY_TOKEN="换成随机串"
RELAY_RATE_PER_MINUTE="12"
# 用外部 HTTP 邮件 API（Resend 等）时改成它的地址，并可整段删掉 mail-relay 服务
EMAIL_API_URL="http://mail-relay:8080/send"

# —— 平台与定时消费 ——
APP_URL="https://你的访问地址"
CRON_SECRET="换成随机串（与主机 cron 用的那个值一致）"
SUPABASE_PUBLIC_URL="https://你的访问地址"

# —— 官方 compose 的必填项：留在官方 .env 里，不要在这里重写 ——
# POSTGRES_PASSWORD / JWT_SECRET / ANON_KEY / SUPABASE_PUBLISHABLE_KEY
# SERVICE_ROLE_KEY / SUPABASE_SECRET_KEY / DASHBOARD_USERNAME / DASHBOARD_PASSWORD
# SITE_URL / API_EXTERNAL_URL
