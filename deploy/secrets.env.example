# 复制成部署目录下的 .env（chmod 600），只填值、不要提交、不要贴进聊天或工单。
# 生成随机密钥：openssl rand -hex 32

# —— 邮件（QQ 邮箱授权码方案）——
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=你的账号@qq.com
SMTP_PASS=在这里填 QQ 邮箱的 SMTP 授权码（不是 QQ 密码，也不是邮箱登录密码）
EMAIL_FROM=成都七中科学技术协会 <你的账号@qq.com>
# 中继自己的 Bearer 密钥：app-api 的 EMAIL_API_KEY 与 mail-relay 的 RELAY_TOKEN 共用这一个值
EMAIL_RELAY_TOKEN=换成随机串
RELAY_RATE_PER_MINUTE=12
# 用外部 HTTP 邮件 API（Resend 等）时改成它的地址，并可整段删掉 mail-relay 服务
EMAIL_API_URL=http://mail-relay:8080/send

# —— 平台与定时消费 ——
APP_URL=https://你的访问地址
CRON_SECRET=换成随机串（与主机 cron 用的那个值一致）
SUPABASE_PUBLIC_URL=https://你的访问地址

# —— 官方 compose 自带的必填项（这里只列名字，值自己生成/保管）——
# POSTGRES_PASSWORD=
# JWT_SECRET=
# ANON_KEY= / SUPABASE_PUBLISHABLE_KEY=
# SERVICE_ROLE_KEY= / SUPABASE_SECRET_KEY=
# DASHBOARD_USERNAME= / DASHBOARD_PASSWORD=
# SITE_URL= / API_EXTERNAL_URL=
